{
  "name": "underscore-web-highlighter",
  "version": "0.1.0",
  "description": "Underscore Highlighter — highlight the web and save passages to a searchable library",
  "author": "Sandeep Singh",
  "license": "GPL-3.0-only",
  "keywords": [
    "browser-extension",
    "highlighter",
    "productivity",
    "reading"
  ],
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:web": "vite --config vite.config.web.ts --mode development",
    "web:dev": "node --env-file=.env.development ./node_modules/vite/bin/vite.js --config vite.config.web.ts --mode development",
    "build:web": "vite build --config vite.config.web.ts",
    "web:build": "node --env-file=.env.development ./node_modules/vite/bin/vite.js build --config vite.config.web.ts",
    "web:pages-dev": "npm run web:build && npx wrangler pages dev dist-web --project-name=underscore-web --compatibility-date=2024-12-01",
    "web:deploy": "node --env-file=.env.production ./node_modules/vite/bin/vite.js build --config vite.config.web.ts --mode production && npx wrangler pages deploy dist-web --project-name=underscore-web --branch=main --commit-dirty=true",
    "supabase:link": "npx supabase link --project-ref cuzwaukxagefyvtxbqmi",
    "supabase:push": "npx supabase db push --linked --yes",
    "supabase:migrate": "npm run supabase:link && npm run supabase:push",
    "build": "wxt build",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip --browser firefox",
    "zip:chrome": "wxt zip --browser chrome",
    "store:amo-screenshots": "node scripts/generate-amo-screenshots.mjs",
    "clean": "rm -rf .wxt dist .output",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,html,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --run",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check:legacy-ds": "bash scripts/check-legacy-ds.sh",
    "check:legacy-ds:src": "bash scripts/check-legacy-ds.sh src/",
    "check:legacy-ds:strict": "bash scripts/check-legacy-ds.sh --strict src/",
    "check:legacy-ds:test": "vitest run tests/unit/harness/check-legacy-ds.test.ts",
    "quality": "npm run type-check && npm run lint && npm run format:check && npm run test && npm run check:legacy-ds:src",
    "quality:full": "npm run type-check && npm run lint && npm run format:check && npm run test:coverage:check && npm run check:legacy-ds:src",
    "postinstall": "wxt prepare",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:visual:ui": "playwright test --project=visual --ui",
    "test:visual:report": "playwright show-report",
    "mcp:build": "npm run build --prefix packages/mcp-server",
    "mcp:dev": "npm run dev --prefix packages/mcp-server",
    "web:deploy:vercel": "bash scripts/deploy-vercel-web.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/chrome": "^0.1.32",
    "@types/dexie": "^1.3.32",
    "@types/diff-match-patch": "^1.0.36",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.0.3",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unicorn": "^62.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.4.0",
    "playwright": "^1.57.0",
    "prettier": "^3.7.4",
    "terser": "^5.44.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.16",
    "wxt": "^0.20.27"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.97.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.2.1",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.3.1",
    "framer-motion": "^11.18.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.12.0",
    "remark-breaks": "^4.0.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "tldts": "^7.4.2",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.2.1"
  }
}
