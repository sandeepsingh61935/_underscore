{
  "name": "@underscore/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for _underscore highlights (Cloud MCP Worker)",
  "homepage": "https://underscore-web-3i0.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandeepsingh61935/_underscore.git",
    "directory": "packages/mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "highlights",
    "web-highlighter",
    "annotations",
    "research"
  ],
  "author": "underscore",
  "license": "MIT",
  "type": "module",
  "bin": {
    "underscore-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "worker:secret:url": "wrangler secret put SUPABASE_URL",
    "worker:secret:key": "wrangler secret put SUPABASE_ANON_KEY",
    "worker:deploy": "npm run build && wrangler deploy",
    "worker:dev": "wrangler dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@supabase/supabase-js": "^2.97.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.14.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
